# ============================================
# ANPR Client Backend - Environment Configuration
# ============================================
# Copy this file to .env and configure your settings

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME="ANPR Client Backend"
APP_VERSION="1.0.0"
PROJECT_NAME="Default Project"  # Configure your project/client name here
API_V1_PREFIX="/api/v1"
DEBUG=False

# ============================================
# SERVER SETTINGS
# ============================================
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# ============================================
# DATABASE SETTINGS
# ============================================
DB_URL="postgresql://anpr_user:anpr_password@localhost:5432/anpr_client_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ============================================
# REDIS SETTINGS
# ============================================
REDIS_URL="redis://localhost:6379/0"

# ============================================
# CENTRAL SERVER SETTINGS
# ============================================
ORGANIZATION_ID=1
CENTRAL_SERVER_URL="https://flowershow.kushaldulani.xyz/api/v1/anpr/upload"
CENTRAL_SERVER_API_KEY="your-api-key-here"
CENTRAL_SERVER_TIMEOUT=30
CENTRAL_SERVER_ENABLED=True  # Set to False to disable uploads

# ============================================
# YOLO MODEL SETTINGS
# ============================================
MODEL_PATH="yolov8n.pt"

# Detection Classes (COCO dataset)
# Available classes: 0=person, 2=car, 3=motorcycle, 5=bus, 7=truck
DETECTION_CLASSES_STR="0,2,3,5,7"

# ============================================
# STORAGE SETTINGS
# ============================================
# DETECTIONS_DIR will default to "detections" folder in project root
# DETECTIONS_DIR="/path/to/custom/detections"

# ============================================
# RTSP/STREAM SETTINGS
# ============================================
# RTSP Transport: "udp" (faster, less reliable) or "tcp" (slower, more reliable)
# Use TCP if you experience stream corruption errors
RTSP_TRANSPORT="udp"

TARGET_FPS=30
CONFIDENCE=0.5
ZONE_PROXIMITY=100

# ============================================
# DETECTION SETTINGS
# ============================================
MAX_IMAGES_PER_VEHICLE=3
FRAMES_BETWEEN_SAVES=10

# ============================================
# UPLOAD RETRY SETTINGS
# ============================================
MAX_RETRIES=4
RETRY_DELAY_1=5       # 5 seconds
RETRY_DELAY_2=60      # 1 minute
RETRY_DELAY_3=300     # 5 minutes
RETRY_DELAY_4=3600    # 1 hour

# ============================================
# CORS SETTINGS
# ============================================
# Note: These use default values from code if not specified
# CORS_ORIGINS=["*"]
# CORS_CREDENTIALS=True
# CORS_METHODS=["*"]
# CORS_HEADERS=["*"]

# ============================================
# LOGGING SETTINGS
# ============================================
LOG_LEVEL="INFO"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
